# --- Credential cascade -----------------------------------------------
# Every Node entry point (Vite dev middleware, build script, DB client, MCP
# server, pricing export) reads config the same way:
#   process.env → this file (.env.local) → the instance profile → the files
#   named by TIMELINES_ENV_FILE
# Earlier wins. Both file seams are optional, so a fresh checkout reads nothing
# outside the repo.

# --- Instance profile --------------------------------------------------
# One checkout serves several deployments: a production site, a staging site, a
# throwaway test DB. Each is an "instance" — a name plus the values that point
# at it (database, data subfolder, JIRA account, host site).
#
# Those values live OUTSIDE the repo, one file per instance:
#   ~/.config/ganttry/instances/<name>.env
# so instance identity never becomes a tracked file and switching is one line
# here rather than a rewrite of this file. Names are a single path segment of
# [A-Za-z0-9._-]; anything else is ignored rather than resolved.
#
#   TIMELINES_INSTANCE=staging
#   TIMELINES_INSTANCE_DIR=          # override the directory above, optional
#
# A profile is a plain .env holding whatever that deployment needs, e.g.:
#   TIMELINES_SUPABASE_URL=…
#   TIMELINES_SUPABASE_SERVICE_KEY=…
#   VITE_SUPABASE_URL=…
#   VITE_SUPABASE_ANON_KEY=…
#   TIMELINES_SOURCES_SUBDIR=acme
#   JIRA_BASE_URL= / JIRA_EMAIL= / JIRA_API_TOKEN=
#   NETLIFY_SITE_ID=…                # so the netlify CLI targets this site
#   TIMELINES_DATA_DIR= / TIMELINES_PORT=   # see below, for side-by-side dev
# Unset = no profile, the plain single-deployment setup.
TIMELINES_INSTANCE=

# --- Two instances from one checkout -----------------------------------
# Running two instances side by side locally (say a test one and the one that
# mirrors production) needs two things kept apart, because both would otherwise
# be shared repo state:
#
#   TIMELINES_DATA_DIR   build output directory under public/ (default "data").
#                        `npm run build:data` writes there and the client reads
#                        the matching URL prefix, derived from this same value
#                        in vite.config.ts. Two instances sharing one directory
#                        overwrite each other's build.
#   TIMELINES_PORT       dev server port (default 3120). `dev-prep.sh` reads it
#                        too, so starting one instance never kills the other.
#
# Both belong in the instance profile. A single-instance setup leaves them unset
# and stays on public/data + port 3120. public/data-*/ is gitignored.
TIMELINES_DATA_DIR=
TIMELINES_PORT=

# TIMELINES_ENV_FILE is the older, coarser seam: credentials shared across
# several projects rather than tied to one instance. Takes one or more paths
# separated by ":", each may start with "~/". Missing files are ignored.
# The instance profile outranks these files.
#   TIMELINES_ENV_FILE=~/.config/ganttry/.env
TIMELINES_ENV_FILE=

# --- Build-time (Vite + build script) ---------------------------------
# The two settings below are the ones that usually differ per instance, so in
# a multi-instance setup they belong in the profile rather than here.

# Which subfolder of data/ to scan for local sources, JSON files and directories
# of Markdown alike. Empty/unset = scan data/. Set to a subfolder name (e.g.
# "acme") to scope a deploy to just data/<subfolder>/. Those subfolders are
# gitignored: top-level data/*.json are the shipped examples, everything in a
# subfolder is one deployment's own data and stays local.
TIMELINES_SOURCES_SUBDIR=

# Public base URL for JIRA "…/browse/<KEY>" links shown in the detail panel.
# Build-time, NOT a secret. Empty by default → linked issues render as plain
# text keys. Set to your Atlassian Cloud origin to make them clickable.
VITE_JIRA_BASE_URL=

# --- JIRA autosuggest proxy (server-side, NEVER in the client bundle) -
# Used by the Vite dev middleware (`/api/jira/search`) to query JIRA Cloud's
# issue picker. Set them here in .env.local (gitignored), or in a file named by
# TIMELINES_ENV_FILE. process.env wins over both.
#   JIRA_BASE_URL   = https://your-org.atlassian.net
#   JIRA_EMAIL      = your-account@your-org.com
#   JIRA_API_TOKEN  = Atlassian API token (id.atlassian.com → Security → API tokens)

# --- Runtime (Netlify Edge Function only) -----------------------------
# These do NOT belong in this file — set them in the Netlify dashboard
# (Site settings → Environment variables) so they aren't checked in.
# Listed here only as a checklist:
#
#   AUTH_REQUIRED          = "true" to enable the auth gate
#   GOOGLE_CLIENT_ID       = OAuth client ID (Google Cloud Console)
#   GOOGLE_CLIENT_SECRET   = OAuth client secret
#   AUTH_SECRET            = `openssl rand -base64 32`
#   ALLOWED_EMAIL_DOMAINS  = comma-separated allowed sign-in domains (empty = nobody)
#   JIRA_ENABLED           = "true" to activate the JIRA autosuggest proxy
#   JIRA_BASE_URL          = https://your-org.atlassian.net
#   JIRA_EMAIL             = service-account email
#   JIRA_API_TOKEN         = service-account API token (secret)
