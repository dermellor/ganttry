# --- Build-time (Vite + build script) ---------------------------------
# Which subfolder of data/ to scan for *.json sources.
# Empty/unset = scan data/*.json. Set to a subfolder name (e.g. "acme")
# to scope a deploy to just data/<subfolder>/*.json.
TIMELINES_SOURCES_SUBDIR=

# Directory scanned for Markdown notes. Overrides notesDir in
# timelines.config.json (same ~ expansion). A missing directory is non-fatal
# (build warns and proceeds with zero notes).
TIMELINES_NOTES_DIR=

# When "true", skip the markdown notes scan entirely and drop all
# notes-driven views from the config. Use this for a static-only deploy where
# no notes directory is checked in.
TIMELINES_STATIC_ONLY=

# Public base URL for JIRA "…/browse/<KEY>" links shown in the detail panel.
# Build-time, NOT a secret. Empty by default → linked issues render as plain
# text keys. Set to your Atlassian Cloud origin to make them clickable.
VITE_JIRA_BASE_URL=

# --- JIRA autosuggest proxy (server-side, NEVER in the client bundle) -
# Used by the Vite dev middleware (`/api/jira/search`) to query JIRA Cloud's
# issue picker. Locally these live in ~/_AGENTS/.env (cross-project keys) or
# here in .env.local — both are gitignored. process.env wins over the files.
#   JIRA_BASE_URL   = https://your-org.atlassian.net
#   JIRA_EMAIL      = your-account@your-org.com
#   JIRA_API_TOKEN  = Atlassian API token (id.atlassian.com → Security → API tokens)

# --- Runtime (Netlify Edge Function only) -----------------------------
# These do NOT belong in this file — set them in the Netlify dashboard
# (Site settings → Environment variables) so they aren't checked in.
# Listed here only as a checklist:
#
#   AUTH_REQUIRED          = "true" to enable the auth gate
#   GOOGLE_CLIENT_ID       = OAuth client ID (Google Cloud Console)
#   GOOGLE_CLIENT_SECRET   = OAuth client secret
#   AUTH_SECRET            = `openssl rand -base64 32`
#   ALLOWED_EMAIL_DOMAINS  = comma-separated allowed sign-in domains (empty = nobody)
#   JIRA_ENABLED           = "true" to activate the JIRA autosuggest proxy
#   JIRA_BASE_URL          = https://your-org.atlassian.net
#   JIRA_EMAIL             = service-account email
#   JIRA_API_TOKEN         = service-account API token (secret)
