node_modules
dist
public/data/notes.json
public/data/config.json
public/data/sources/
# Build output of a second instance in the same checkout (TIMELINES_DATA_DIR).
public/data-*/
.vite
.netlify
.env
.env.local
.env.netlify
.env.*.local
