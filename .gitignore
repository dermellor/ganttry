.DS_Store

# Supabase CLI link state (contains connection secrets)
supabase/.temp/

# Netlify/Deno edge bundling artifact
deno.lock

# Host-specific development setup (ports, process manager, reverse proxy).
# Not part of the project — see AGENTS.md for the project-level rules.
.claude/local-setup.md

# Instance source data. data/*.json at the top level are the shipped examples;
# every subdirectory belongs to one deployment (TIMELINES_SOURCES_SUBDIR picks
# it) and stays local. Ignored as a directory so a stray `git add data` cannot
# pull a customer roadmap into the public history.
data/*/

# Generated by scripts/build-data.ts from the instance's environment: the CSP
# depends on which Supabase/JIRA/plugin origins THIS deploy allows, so a
# committed copy would be one instance's policy imposed on every other.
public/_headers

# Vendored plugin artifacts. WHICH plugins a deployment carries is instance
# state, exactly like `data/<subdir>/`, so the artifacts stay out of the public
# history — and a stray `git add plugins` cannot publish somebody's private
# plugin. `plugins/README.md` is the committed explanation of the directory.
plugins/*/
public/plugins/
