{
  "name": "timelines",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build:data": "tsx scripts/build-data.ts",
    "watch:data": "tsx scripts/build-data.ts --watch",
    "watch:data:notes": "tsx scripts/build-data.ts --watch --watch-notes",
    "sheets:auth": "tsx scripts/sheets/auth.ts",
    "sheets:sync": "tsx scripts/build-data.ts",
    "db:import": "tsx scripts/db/import.ts",
    "dev": "bash scripts/dev-prep.sh && npm run build:data && concurrently -n data,vite -c yellow,cyan \"npm run watch:data\" \"vite\"",
    "dev:notes": "bash scripts/dev-prep.sh && npm run build:data && concurrently -n data,vite -c yellow,cyan \"npm run watch:data:notes\" \"vite\"",
    "build": "npm run build:data && vite build",
    "export": "npm run build:data && tsx scripts/export-view.ts",
    "preview": "vite preview",
    "mcp": "tsx scripts/mcp/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "marked": "^14.1.0",
    "vis-data": "^7.1.9",
    "vis-timeline": "^7.7.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "chokidar": "^3.6.0",
    "concurrently": "^9.0.0",
    "gray-matter": "^4.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
