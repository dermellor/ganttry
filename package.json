{
  "name": "timelines",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build:data": "tsx scripts/build-data.ts",
    "watch:data": "tsx scripts/build-data.ts --watch",
    "watch:data:notes": "tsx scripts/build-data.ts --watch --watch-notes",
    "db:import": "tsx scripts/db/import.ts",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "dev": "bash scripts/dev-prep.sh && npm run build:data && concurrently -n data,vite -c yellow,cyan \"npm run watch:data\" \"vite\"",
    "dev:worktree": "npm run build:data && vite --strictPort --port ${WT_PORT:-31200}",
    "dev:notes": "bash scripts/dev-prep.sh && npm run build:data && concurrently -n data,vite -c yellow,cyan \"npm run watch:data:notes\" \"vite\"",
    "build": "npm run build:data && vite build",
    "export": "npm run build:data && tsx scripts/export-view.ts",
    "export:pricing": "tsx scripts/pricing-export.ts",
    "preview": "vite preview",
    "test": "TZ=Europe/Berlin node --import tsx --test '{src,scripts}/**/*.test.ts'",
    "mcp": "tsx scripts/mcp/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "marked": "^14.1.0",
    "postgres": "^3.4.9",
    "turndown": "^7.2.4",
    "vis-data": "^7.1.9",
    "vis-timeline": "^7.7.3",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "chokidar": "^3.6.0",
    "concurrently": "^9.0.0",
    "gray-matter": "^4.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
